{
  "ConnectionStrings": {
    "StaffIdentityDb": "Host=localhost;Database=staffidentityapi;Username=postgres;Password=postgres"
  },
  "ApiKeys": {
    "Clients": []
  },
  "PasswordPolicy": {
    "MinimumLength": 12
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Update": "Fatal",
        "Garbati.StaffIdentityApi.Authorization.ApiKeyAuthenticationHandler": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
